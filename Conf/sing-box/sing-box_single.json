{
  "$schema": "https://sing-box.sagernet.org/schema.json",
  "log": {
      "disabled": false,
      "level": "info",
      "output": "sing-box.log",
      "timestamp": true
  },
  "http_clients": [
    { 
      "tag": "default",
      "disable_version_fallback": true,
      "version": 2,
      "detour": "🌐 全局选择"
    }
  ],
  "services": [
    {
      "type": "api",
      "tag": "sing-box dashboard",
      "listen": "127.0.0.1",
      "listen_port": 9091,
      "secret": "",
      "access_control_allow_private_network": true,
      "access_control_allow_origin": [
        "http://sing-box-dashboard.sagernet.org",
        "http://dash.sing-box.app"
      ]
    }
  ],
  "dns": {
    "optimistic": true,
    "reverse_mapping": true,
    "strategy": "ipv4_only",
    "final": "dns_DOH-Ali",
    "servers": [
      { "tag": "Fix_DNS", "type": "hosts",
        "predefined":{
          "dns.alidns.com": ["223.5.5.5", "223.6.6.6"],
          "doh.pub": ["1.12.12.21", "120.53.53.53"]
        }
      },
      { "tag": "dns_DOH-Ali", "type": "https", "server": "dns.alidns.com", "domain_resolver": "Fix_DNS" },
      { "tag": "dns_UDP-Ali", "type": "udp", "server": "223.5.5.5" },
      { "tag": "dns_DOH-Tx", "type": "https", "server": "doh.pub", "domain_resolver": "Fix_DNS" },
      { "tag": "dns_UDP-Tx", "type": "udp", "server": "119.29.29.29" },
      { "tag": "dns_FakeIP", "type": "fakeip", "inet4_range": "198.18.0.0/15", "inet6_range": "fc00::/18" },
      { "tag": "dns_Local", "type": "local", "neighbor_domain": [".local", ".lan"] }
    ],
    "rules": [
      
      { "query_type": "HTTPS", "action": "reject"},
      { "query_type": ["A", "AAAA"], "action":"route", "server": "dns_FakeIP", "rewrite_ttl": 1},

      { "domain_suffix": ["lan", "direct", "local", "corp", "msftncsi.com", "msftconnecttest.com", "srv.nintendo.net", "xboxlive.com", "battlenet.com.cn", "battlenet.com", "blzstatic.cn", "battle.net", "turn.twilio.com", "cmpassport.com", "10099.com.cn"], "server": "dns_Local" },
      { "domain": ["lancache.steamcontent.com", "id6.me", "open.e.189.cn", "mdn.open.wo.cn", "opencloud.wostore.cn", "auth.wosms.cn"], "server": "dns_Local" },

      { "action": "evaluate", "server": "dns_DOH-Ali", "tag": "ali"},
      { "action": "evaluate", "server": "dns_DOH-Tx", "tag": "tencent"},
      { "match_response": "ali", "response_rcode": "NOERROR","action": "respond","race": true },
      { "match_response": "tencent", "response_rcode": "NOERROR","action": "respond","race": true },

      { "clash_mode": "Global", "action": "route", "server": "dns_FakeIP" },
      { "clash_mode": "Direct", "action": "route", "server": "dns_Local" }
    ]
  },
  "inbounds": [
    {
      "type": "mixed",
      "tag": "in-MIXED",
      "listen": "127.0.0.1",
      "listen_port": 7080
    },
    {
      "type" : "tun",
      "tag": "in-TUN",
      "auto_route": true,
      "stack": "mixed",
      "address": [
        "172.18.0.1/30",
        "fdfe:dcba:9876::1/126"
      ],
      "platform": {
        "http_proxy": {
          "enabled": true,
          "server": "127.0.0.1",
          "server_port": 7080
        }
      }
    }
  ],
