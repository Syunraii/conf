[Remote Filter]
No_Filter = NameRegex, FilterKey = ".*"

# 倍率过滤
FilterFor_HR = NameRegex, FilterKey = "^(?=.*(?:[2-9][0-9]*|[1-9][0-9]+\.[0-9]+)[×x]).*$"
FilterOut_HR = NameRegex, FilterKey = "^(?!.*(?:[2-9][0-9]*|[1-9][0-9]*\.[0-9]+)[×x]).*$"
FilterFor_NR = NameRegex, FilterKey = "^(?!.*(?:[2-9][0-9]*|[1-9][0-9]*\.[0-9]+|0\.0?[0-9]+)[×x]).*$"
FilterOut_NR = NameRegex, FilterKey = "^(?!.*[×x]).*$"
FilterFor_LR = NameRegex, FilterKey = "^(?=.*(?:0\.1[×x]|0\.01[×x]|0\.1\b|0\.0[0-9])).*$"
FilterOut_LR = NameRegex, FilterKey = "^(?!.*(?:0\.1[×x]|0\.01[×x]|0\.1\b|0\.0[0-9])).*$"

# 地区+倍率过滤
FilterOutLR_HK = NameRegex, FilterKey = "^(?i)(?!.*(0\.1[×x]|0\.01[×x]|0\.1\b|0\.0[0-9]))(?=.*(🇭🇰|香港|\b(HK|HongKong|Hong Kong)\b)).*$"
FilterOutLR_TW = NameRegex, FilterKey = "^(?i)(?!.*(0\.1[×x]|0\.01[×x]|0\.1\b|0\.0[0-9]))(?=.*(🇨🇳|🇹🇼|台湾|\b(TW|Taiwan)\b)).*$"
FilterOutLR_JP = NameRegex, FilterKey = "^(?i)(?!.*(0\.1[×x]|0\.01[×x]|0\.1\b|0\.0[0-9]))(?=.*(🇯🇵|日本|\b(JP|Japan)\b)).*$"
FilterOutLR_KR = NameRegex, FilterKey = "^(?i)(?!.*(0\.1[×x]|0\.01[×x]|0\.1\b|0\.0[0-9]))(?=.*(🇰🇷|韩国|\b(KR|South Korea)\b)).*$"
FilterOutLR_US = NameRegex, FilterKey = "^(?i)(?!.*(0\.1[×x]|0\.01[×x]|0\.1\b|0\.0[0-9]))(?=.*(🇺🇸|美国|\b(US|USA|United States)\b)).*$"
FilterOutLR_SG = NameRegex, FilterKey = "^(?i)(?!.*(0\.1[×x]|0\.01[×x]|0\.1\b|0\.0[0-9]))(?=.*(🇸🇬|新加坡|狮城|\b(SG|Singapore)\b)).*$"
FilterOutLR_OT = NameRegex, FilterKey = "^(?i)(?!.*(0\.1[×x]|0\.01[×x]|0\.1\b|0\.0[0-9]))(?!.*(🇭🇰|香港|\b(HK|HongKong|Hong Kong)\b|🇨🇳|🇹🇼|台湾|\b(TW|Taiwan)\b|🇯🇵|日本|\b(JP|Japan)\b|🇰🇷|韩国|\b(KR|South Korea)\b|🇺🇸|美国|\b(US|USA|United States)\b|🇸🇬|新加坡|狮城|\b(SG|Singapore)\b)).*$"

[Rule]
#Type:DOMAIN-SUFFIX,DOMAIN,DOMAIN-KEYWORD,USER-AGENT,URL-REGEX,IP-CIDR
#Strategy:DIRECT,PROXY,REJECT
#Options:no-resolve(only for IP-CIDR,IP-CIDR2,GEOIP,IP-ASN)

# 避免应用循环请求
IP-CIDR,0.0.0.0/32,REJECT,no-resolve

