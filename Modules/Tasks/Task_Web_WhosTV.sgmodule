#!name=🛎️ Tasks: WhosTV
#!desc=[任务] whos.tv每日签到
#!system=ios
#!category=🛎️ Tasks: Web

#!author=Ray
#!homepage=https://raw.githubusercontent.com/imzwr214/whos/refs/heads/main/WhosTVSignin.module

#!arguments=获取:获取_WhosTV, 任务:任务_WhosTV, 系统通知:1, 执行时间:8 10 * * *, 超时时间:60, 主机:hostname
#!arguments-desc=1️⃣ 使用方法\n\n登录https://www.whos.tv, 提示获取Cookie成功即可\n\n2️⃣ 任务\n\n执行任务, 输入#关闭

[Script]
# Tasks: WhosTV
{{{获取}}} = type = http-request,requires-body=1,max-size=0,timeout={{{超时时间}}},pattern=^https:\/\/whos\.tv\/api\/(login|user\/profile|user\/statistics|user\/tasks\/today-points|user\/tasks\/signin),script-path=https://raw.githubusercontent.com/imzwr214/whos/main/WhosTVSignin.js

{{{任务}}} = type =cron,wake-system={{{系统通知}}},cronexp={{{执行时间}}},timeout={{{超时时间}}},script-path=https://raw.githubusercontent.com/imzwr214/whos/main/WhosTVSignin.js

[MITM]
{{{主机}}} = %APPEND% whos.tv
